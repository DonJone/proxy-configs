# =====================================
# Remote Rule (引用外部规则库)
# =====================================
[Remote Rule]
https://cdn.jsdelivr.net/gh/DonJone/GinsRule-git@master/rules/loon/direct/bypass-domain.lsr, policy=DIRECT, tag=私有网络, enabled=true
# AI
# AI (Google 域名会匹配 YouTube, AI 必须在 Google 之前)
https://cdn.jsdelivr.net/gh/DonJone/GinsRule-git@master/rules/loon/ai/ai-other.lsr, policy=AI与Google, tag=AI分流, enabled=true
# 流媒体 (YouTube 必须在 Google 之前, 否则被 google.mrs 截走)
https://cdn.jsdelivr.net/gh/DonJone/GinsRule-git@master/rules/loon/proxy/youtube.lsr, policy=Emby流媒体, tag=YouTube, enabled=true
https://cdn.jsdelivr.net/gh/DonJone/GinsRule-git@master/rules/loon/proxy/netflix.lsr, policy=Emby流媒体, tag=Netflix, enabled=true
https://cdn.jsdelivr.net/gh/DonJone/GinsRule-git@master/rules/loon/proxy/disney.lsr, policy=Emby流媒体, tag=Disney, enabled=true
https://cdn.jsdelivr.net/gh/DonJone/GinsRule-git@master/rules/loon/proxy/hbo.lsr, policy=Emby流媒体, tag=HBO, enabled=true
https://cdn.jsdelivr.net/gh/DonJone/GinsRule-git@master/rules/loon/proxy/spotify.lsr, policy=Emby流媒体, tag=Spotify, enabled=true
https://cdn.jsdelivr.net/gh/DonJone/GinsRule-git@master/rules/loon/proxy/appletv.lsr, policy=Emby流媒体, tag=AppleTV, enabled=true
# 社交通讯 (GitHub 必须在 Microsoft 之前)
https://cdn.jsdelivr.net/gh/DonJone/GinsRule-git@master/rules/loon/proxy/telegram.lsr, policy=通讯与Github, tag=Telegram, enabled=true
https://cdn.jsdelivr.net/gh/DonJone/GinsRule-git@master/rules/loon/proxy/twitter.lsr, policy=通讯与Github, tag=Twitter, enabled=true
https://cdn.jsdelivr.net/gh/DonJone/GinsRule-git@master/rules/loon/proxy/github.lsr, policy=通讯与Github, tag=GitHub, enabled=true
https://cdn.jsdelivr.net/gh/DonJone/GinsRule-git@master/rules/loon/proxy/googlefcm.list, policy=通讯与Github, tag=GoogleFCM, enabled=true
# TikTok
https://cdn.jsdelivr.net/gh/DonJone/GinsRule-git@master/rules/loon/proxy/tiktok.lsr, policy=TikTok, tag=TikTok, enabled=true
# 微软苹果Nvidia (Microsoft 可能含 GitHub 域名)
https://cdn.jsdelivr.net/gh/DonJone/GinsRule-git@master/rules/loon/proxy/apple.lsr, policy=微软苹果Nvidia, tag=Apple, enabled=true
https://cdn.jsdelivr.net/gh/DonJone/GinsRule-git@master/rules/loon/proxy/microsoft.lsr, policy=微软苹果Nvidia, tag=Microsoft, enabled=true
# Google (最后, 避免拦截 YouTube/AI 域名)
https://cdn.jsdelivr.net/gh/DonJone/GinsRule-git@master/rules/loon/proxy/google.lsr, policy=AI与Google, tag=Google, enabled=true
# 游戏平台
https://cdn.jsdelivr.net/gh/DonJone/GinsRule-git@master/rules/loon/proxy/steam.lsr, policy=游戏平台, tag=Steam, enabled=true
# 加密货币与兜底
https://cdn.jsdelivr.net/gh/DonJone/GinsRule-git@master/rules/loon/proxy/proxy-list.lsr, policy=加密货币与兜底, tag=Proxy, enabled=true
https://cdn.jsdelivr.net/gh/DonJone/GinsRule-git@master/rules/loon/proxy/gfw-list.lsr, policy=加密货币与兜底, tag=Global, enabled=true
https://cdn.jsdelivr.net/gh/DonJone/GinsRule-git@master/rules/loon/proxy/cloudflare.lsr, policy=加密货币与兜底, tag=Turnstile, enabled=true
# 国内服务
https://cdn.jsdelivr.net/gh/DonJone/GinsRule-git@master/rules/loon/direct/direct-list.lsr, policy=国内服务, tag=国内通用, enabled=true
https://cdn.jsdelivr.net/gh/DonJone/GinsRule-git@master/rules/loon/ip/cn.lsr, policy=国内服务, tag=国内IP, enabled=true


