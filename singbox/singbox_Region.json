{
  "$schema": "https://raw.githubusercontent.com/SagerNet/sing-box/main/docs/schema.json",
  "log": {
    "disabled": false,
    "level": "info",
    "timestamp": true
  },
  "experimental": {
    "clash_api": {
      "external_controller": "0.0.0.0:9090",
      "external_ui": "zashboard",
      "external_ui_download_url": "https://github.com/Zephyruso/zashboard/releases/latest/download/dist.zip",
      "external_ui_download_detour": "DIRECT",
      "secret": "",
      "default_mode": "Rule"
    },
    "cache_file": {
      "enabled": true,
      "path": "cache.db",
      "store_fakeip": true
    }
  },
  "http_clients": [
    {
      "tag": "http-direct"
    },
    {
      "tag": "http-proxy",
      "detour": "兜底"
    }
  ],
  "dns": {
    "strategy": "prefer_ipv4",
    "servers": [
      {
        "type": "https",
        "tag": "dns-direct",
        "server": "223.5.5.5"
      },
      {
        "type": "https",
        "tag": "dns-proxy",
        "server": "dns.google",
        "domain_resolver": "dns-direct",
        "detour": "兜底"
      },
      {
        "type": "udp",
        "tag": "dns-local",
        "server": "223.5.5.5"
      },
      {
        "type": "fakeip",
        "tag": "dns-fakeip",
        "inet4_range": "198.18.0.0/15",
        "inet6_range": "fc00::/18"
      }
    ],
    "rules": [
      {
        "clash_mode": "Direct",
        "server": "dns-direct"
      },
      {
        "clash_mode": "Global",
        "server": "dns-proxy"
      },
      {
        "domain": [
          "dns.google",
          "dns.alidns.com",
          "doh.pub"
        ],
        "server": "dns-direct"
      },
      {
        "rule_set": "rule-direct",
        "server": "dns-direct"
      },
      {
        "rule_set": [
          "rule-apac",
          "rule-ai",
          "rule-lowrate"
        ],
        "server": "dns-fakeip"
      },
      {
        "query_type": [
          "A",
          "AAAA"
        ],
        "server": "dns-fakeip"
      }
    ],
    "final": "dns-proxy"
  },
  "inbounds": [
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "::",
      "listen_port": 7890
    },
    {
      "type": "tun",
      "tag": "tun-in",
      "interface_name": "utun",
      "address": [
        "172.19.0.1/30",
        "fdfe:dcba:9876::1/126"
      ],
      "auto_route": true,
      "strict_route": true
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "DIRECT"
    },
    {
      "type": "selector",
      "tag": "亚太",
      "outbounds": [
        "DIRECT"
      ]
    },
    {
      "type": "selector",
      "tag": "AI",
      "outbounds": [
        "DIRECT"
      ]
    },
    {
      "type": "urltest",
      "tag": "低倍自动",
      "outbounds": [
        "DIRECT"
      ],
      "url": "https://cp.cloudflare.com/generate_204",
      "interval": "3m",
      "tolerance": 30
    },
    {
      "type": "selector",
      "tag": "低倍",
      "outbounds": [
        "低倍自动"
      ]
    },
    {
      "type": "selector",
      "tag": "兜底",
      "outbounds": [
        "低倍",
        "亚太",
        "AI",
        "DIRECT"
      ]
    }
  ],
  "route": {
    "default_domain_resolver": "dns-direct",
    "default_http_client": "http-direct",
    "rule_set": [
      {
        "tag": "rule-direct",
        "type": "remote",
        "format": "binary",
        "url": "https://fastly.jsdelivr.net/gh/DonJone/proxy-rulesets@release/rules/singbox/direct.srs",
        "http_client": "http-direct",
        "update_interval": "1d"
      },
      {
        "tag": "rule-apac",
        "type": "remote",
        "format": "binary",
        "url": "https://fastly.jsdelivr.net/gh/DonJone/proxy-rulesets@release/rules/singbox/apac.srs",
        "http_client": "http-proxy",
        "update_interval": "1d"
      },
      {
        "tag": "rule-ai",
        "type": "remote",
        "format": "binary",
        "url": "https://fastly.jsdelivr.net/gh/DonJone/proxy-rulesets@release/rules/singbox/ai.srs",
        "http_client": "http-proxy",
        "update_interval": "1d"
      },
      {
        "tag": "rule-lowrate",
        "type": "remote",
        "format": "binary",
        "url": "https://fastly.jsdelivr.net/gh/DonJone/proxy-rulesets@release/rules/singbox/lowrate.srs",
        "http_client": "http-proxy",
        "update_interval": "1d"
      }
    ],
    "rules": [
      {
        "action": "sniff"
      },
      {
        "action": "hijack-dns",
        "protocol": "dns"
      },
      {
        "clash_mode": "Direct",
        "outbound": "DIRECT"
      },
      {
        "clash_mode": "Global",
        "outbound": "兜底"
      },
      {
        "ip_cidr": [
          "169.254.169.254/32"
        ],
        "action": "reject"
      },
      {
        "port": [
          123
        ],
        "outbound": "DIRECT"
      },
      {
        "domain_keyword": [
          "ntp"
        ],
        "domain_suffix": [
          "pool.ntp.org",
          "ntsc.ac.cn",
          "campus.edu.cn"
        ],
        "outbound": "DIRECT"
      },
      {
        "port": [
          5223,
          2195,
          2196,
          5228,
          5229,
          5230
        ],
        "outbound": "DIRECT"
      },
      {
        "ip_cidr": [
          "17.0.0.0/8"
        ],
        "outbound": "DIRECT"
      },
      {
        "rule_set": "rule-direct",
        "outbound": "DIRECT"
      },
      {
        "rule_set": "rule-apac",
        "outbound": "亚太"
      },
      {
        "action": "reject",
        "network": "udp",
        "port": [
          443
        ]
      },
      {
        "rule_set": "rule-ai",
        "outbound": "AI"
      },
      {
        "rule_set": "rule-lowrate",
        "outbound": "低倍"
      }
    ],
    "final": "兜底",
    "auto_detect_interface": true
  }
}
